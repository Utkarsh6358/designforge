generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  attempts  Attempt[]
  createdAt DateTime  @default(now())
}

model Problem {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  description  String
  requirements String    // JSON array stored as string
  constraints  String    // JSON array stored as string
  difficulty   String    // "Easy" | "Medium" | "Hard"
  rubric       Rubric?
  attempts     Attempt[]
  createdAt    DateTime  @default(now())
}

model Rubric {
  id         String  @id @default(cuid())
  problemId  String  @unique
  problem    Problem @relation(fields: [problemId], references: [id])
  dimensions String  // JSON array: [{name, description, weight, maxScore}]
}

model Attempt {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  problemId   String
  problem     Problem      @relation(fields: [problemId], references: [id])
  status      String       @default("Draft") // Draft | Submitted | Evaluating | Completed | Failed
  startedAt   DateTime     @default(now())
  submittedAt DateTime?
  submissions Submission[]
}

model Submission {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    Attempt     @relation(fields: [attemptId], references: [id])
  version    Int         @default(1)
  content    String      // JSON: {classes, responsibilities, relationships, designDecisions}
  format     String      @default("structured-text")
  isDraft    Boolean     @default(true)
  evaluation Evaluation?
  createdAt  DateTime    @default(now())

  @@unique([attemptId, version])
}

model Evaluation {
  id            String     @id @default(cuid())
  submissionId  String     @unique
  submission    Submission @relation(fields: [submissionId], references: [id])
  evaluatorType String     // "rule-based" | "ai" | "composite"
  status        String     @default("Pending") // Pending | Running | Completed | Failed | Partial
  overallScore  Float?
  startedAt     DateTime   @default(now())
  completedAt   DateTime?
  feedback      Feedback[]
}

model Feedback {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  criterion    String
  score        Float
  maxScore     Float
  evidence     String
  concern      String
  suggestion   String
  confidence   Float      @default(1.0)
}
